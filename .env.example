# Django Core Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# MySQL Database Configuration
DB_NAME=smartlostfound
DB_USER=root
DB_PASSWORD=YOUR_WORKING_MYSQL_PASSWORD
DB_HOST=localhost
DB_PORT=3306

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Settings (Uses console backend for development/testing if EMAIL_HOST is not provided)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply.smartlostfound@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=Smart Lost & Found <noreply.smartlostfound@gmail.com>

# AI Matching Algorithm Weights (Must sum to 100)
WEIGHT_IMAGE=50
WEIGHT_CATEGORY=15
WEIGHT_COLOUR=10
WEIGHT_DESCRIPTION=10
WEIGHT_LOCATION=10
WEIGHT_DATE=5

# Confidence Thresholds
THRESHOLD_HIGH=75.0
THRESHOLD_MEDIUM=50.0
